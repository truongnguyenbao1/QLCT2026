{
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/landing.html"
    },
    {
      "src": "/landing",
      "dest": "/landing.html"
    },
    {
      "src": "/app/(.*)",
      "dest": "/app/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
